---
layout: base.njk
---
{% from "icons.njk" import arrow, folder %}
<div class="site-frame workspace">
  <nav class="tree-rail" aria-label="Repository index">
    <p class="tree-root">{{ site.repository }}</p>
    <ul class="tree-list" role="list">
      <li><a class="tree-link tree-readme" href="#readme">README.md</a></li>
      <li>
        <a class="tree-link" href="#projects">Public labs</a>
        <ul class="tree-children" role="list">
          {% for group in projects %}
          {% for project in group.repos %}
          <li><a class="tree-link" href="#{{ project.repo }}">{{ project.repo }}</a></li>
          {% endfor %}
          {% endfor %}
        </ul>
      </li>
    </ul>
  </nav>

  <div class="readme" id="readme">
    <nav class="breadcrumb" aria-label="Homepage context">
      <a href="{{ profile.github }}/{{ site.repository }}">{{ site.repository }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">README.md</span>
    </nav>

    <section class="profile" aria-labelledby="profile-name">
      <h1 id="profile-name">{{ profile.firstName }} {{ profile.lastName }}</h1>
      <p class="bio">{{ profile.bio }}</p>
    </section>

    <nav class="topic-nav" aria-label="Browse projects by topic">
      {% for group in projects %}
      <a href="#{{ group.id }}">{{ group.label }}</a>
      {% endfor %}
    </nav>

    <section class="projects" id="projects" aria-labelledby="projects-title">
      <div class="project-header">
        <h2 id="projects-title">Selected projects</h2>
        <a class="all-repos" href="{{ profile.github }}?tab=repositories">All repositories {{ arrow() }}</a>
      </div>
      <div class="project-index">
        {% for group in projects %}
        <section class="project-group" id="{{ group.id }}" aria-labelledby="{{ group.id }}-title">
          <h3 class="visually-hidden" id="{{ group.id }}-title">{{ group.label }}</h3>
          <ul class="project-list" role="list">
            {% for project in group.repos %}
            <li class="project-item" id="{{ project.repo }}">
              <a class="project-link" href="{{ profile.github }}/{{ project.repo }}">
                <span class="project-folder">{{ folder() }}</span>
                <div class="project-body">
                  <h4>{{ project.repo }}</h4>
                  <p>{{ project.description }}</p>
                </div>
                <span class="project-topic" aria-hidden="true">{{ group.label }}</span>
                <span class="project-arrow">{{ arrow() }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </section>
        {% endfor %}
      </div>
    </section>
  </div>
</div>
